<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MuhilMusic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.MuhilMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MuhilMusic</item>
    </style>
</resources>
